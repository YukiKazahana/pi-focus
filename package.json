{
  "name": "pi-focus",
  "version": "0.1.0",
  "description": "Compact tool output and a persistent progress widget for Pi.",
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["index.ts", "README.md"],
  "pi": { "extensions": ["./index.ts"] },
  "scripts": { "test": "node --experimental-strip-types test.ts", "check": "tsc --noEmit --target es2022 --module nodenext --moduleResolution nodenext --allowImportingTsExtensions --strict --skipLibCheck index.ts test.ts" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YukiKazahana/pi-focus.git"
  },
  "homepage": "https://github.com/YukiKazahana/pi-focus#readme",
  "bugs": { "url": "https://github.com/YukiKazahana/pi-focus/issues" },
  "engines": { "node": ">=22.6.0" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
